<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>DomainKit 的 Entity Framework Core 持久化、審計、事件派發與 DI 註冊套件。</Description>
  </PropertyGroup>
  <PropertyGroup>
    <!-- RS0027：新增的多載與既有帶選擇性參數的多載，參數型別不一致，不會產生多載解析歧義；既有公開 API 不調整參數以維持相容。 -->
    <NoWarn>$(NoWarn);RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DomainKit\DomainKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CloudyWing.Enumeration" Version="0.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>
</Project>
